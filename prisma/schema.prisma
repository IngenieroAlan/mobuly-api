generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients     Client[]
  services    Service[]
  appointments Appointment[]

  @@map("users")
}

model Client {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  nombre        String
  apellido      String
  email         String?
  telefono      String?
  notasGenerales String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([userId])
  @@map("clients")
}

model Service {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  nombre         String
  descripcion    String?
  precio         Decimal  @db.Decimal(10, 2)
  duracionMinutos Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([userId])
  @@map("services")
}

model Appointment {
  id         String            @id @default(uuid()) @db.Uuid
  userId     String            @db.Uuid
  clienteId  String            @db.Uuid
  servicioId String?           @db.Uuid
  fechaInicio DateTime
  fechaFin   DateTime
  estado     AppointmentStatus @default(PENDING)
  notasCita  String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client  Client   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [servicioId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([clienteId])
  @@index([servicioId])
  @@index([fechaInicio])
  @@index([estado])
  @@index([userId, fechaInicio, estado])
  @@map("appointments")
}
